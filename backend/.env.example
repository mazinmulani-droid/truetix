# =================================================================
# TRUETIX BACKEND ENVIRONMENT VARIABLES
# =================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection
# Local Docker: postgresql://postgres:postgres@localhost:5433/clgv_db?schema=public
# Render / Cloud PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clgv_db?schema=public"

# Redis Configuration (Used for real-time seat locks and Redlock)
# If Redis is unavailable, backend automatically falls back to built-in in-memory locking
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_SECRET=truetix_jwt_super_secret_key_2026
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=truetix_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRATION=604800s

# HMAC SHA-256 Secret for QR Ticket Generation & Gate Verification
TICKET_HMAC_SECRET=truetix_hmac_qr_secret_key_2026

# Mock Payment Gateway Host
MOCK_VNPAY_HOST=http://localhost:4000
