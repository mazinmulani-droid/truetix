# =================================================================
# TRUETIX BACKEND ENVIRONMENT VARIABLES
# =================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Web Frontend URL (Used for CORS and mock payment redirection)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
# Local Docker default: postgresql://postgres:postgres@localhost:5433/clgv_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/clgv_db?schema=public"

# Redis Configuration (Ephemeral seat locks with SET NX EX 600)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_SECRET=truetix_jwt_super_secret_key_2026
JWT_EXPIRATION=86400s
JWT_REFRESH_SECRET=truetix_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRATION=604800s

# HMAC SHA-256 Secret for QR Ticket Generation & Gate Verification
TICKET_HMAC_SECRET=truetix_hmac_qr_secret_key_2026

# HMAC SHA-256 Secret for Mock Payment Gateway Simulation
PAYMENT_HMAC_SECRET=truetix_mock_payment_secret_2026
